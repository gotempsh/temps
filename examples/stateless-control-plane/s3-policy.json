{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListOnlyThisInstance",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::REPLACE_BUCKET",
      "Condition": {
        "StringLike": {"s3:prefix": ["instances/REPLACE_INSTANCE_ID/*"]}
      }
    },
    {
      "Sid": "ObjectsOnlyForThisInstance",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:AbortMultipartUpload", "s3:ListMultipartUploadParts"],
      "Resource": "arn:aws:s3:::REPLACE_BUCKET/instances/REPLACE_INSTANCE_ID/*"
    }
  ]
}
