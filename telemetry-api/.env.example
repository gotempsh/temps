# Connection string. In production on Temps, POSTGRES_URL is injected
# automatically when a Postgres service is linked to the project — you don't
# set it by hand. For LOCAL dev, set DATABASE_URL (used as a fallback when
# POSTGRES_URL is absent).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/temps_telemetry
PORT=4200
# Optional: set to a secret to require X-Telemetry-Key header on ingest endpoints
# INGEST_API_KEY=your-secret-key

# Per-IP requests/minute allowed on the unauthenticated
# POST /v1/deploy-failure-reports endpoint. Generous by design (real
# instances send at most a handful of reports ever) -- this is a flood
# floor, not a normal-usage throttle.
FAILURE_REPORT_RATE_LIMIT_PER_MINUTE=30

# Per-IP events/minute accepted across POST /v1/events and
# POST /v1/events/batch. A batch spends one per event, so batching can't
# multiply the budget. Real instances send a few small events a minute.
EVENTS_RATE_LIMIT_PER_MINUTE=600

# Largest `properties` object a single event may carry, in bytes of UTF-8
# JSON. Real events (including error_summary, capped at 20 keys) are a few KiB.
EVENT_PROPERTIES_MAX_BYTES=8192

# Most events accepted in one POST /v1/events/batch request (422 above it).
# Keep it at or below EVENTS_RATE_LIMIT_PER_MINUTE, or a full batch can
# never fit in the rate limit.
EVENTS_BATCH_MAX_EVENTS=100

# Longest temps_version string an event may carry ("0.1.36" is 6). Capped so
# it can't carry what EVENT_PROPERTIES_MAX_BYTES refuses.
TEMPS_VERSION_MAX_CHARS=64

# Longest report_text a deploy-failure report may carry, in characters.
FAILURE_REPORT_MAX_CHARS=200000

# Largest request body accepted on any route, in bytes (413 above it). Must
# fit the largest failure report once JSON-encoded: up to 6 bytes per
# character of FAILURE_REPORT_MAX_CHARS (control characters escape as
# \uXXXX), plus 4 KiB. The default fits 200,000 characters (~1.2 MB).
MAX_REQUEST_BODY_BYTES=2097152

# Each limit falls back to the value shown when unset or not a positive
# whole number, logged as a warning at startup. Limits that contradict each
# other (a batch larger than the rate limit, a body cap smaller than the
# largest report) are used as set but logged as a warning too. Rate limits
# are per client IP over a sliding one-minute window.
