{
  "name": "@temps-sdk/plugin",
  "version": "0.1.0-beta.2",
  "description": "Node.js SDK for building Temps external plugins",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "bun run test:run",
    "test:run": "vitest run --exclude src/tools.test.ts && bun test src/tools.test.ts",
    "test:coverage": "vitest run --coverage --exclude src/tools.test.ts && bun test --coverage src/tools.test.ts",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "temps",
    "plugin",
    "sdk",
    "external-plugin"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.5.4",
    "vitest": "^4.1.0",
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gotempsh/temps.git",
    "directory": "sdks/node/packages/plugin-sdk"
  }
}
