{
  "name": "@temps-sdk/plugin",
  "version": "0.1.0-beta.1",
  "description": "TypeScript SDK for building standalone Temps plugins with Bun",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "temps",
    "plugin",
    "sdk",
    "external-plugin"
  ],
  "license": "MIT",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gotempsh/temps.git",
    "directory": "sdks/node/packages/plugin-sdk"
  },
  "homepage": "https://temps.sh/docs/plugins",
  "bugs": {
    "url": "https://github.com/gotempsh/temps/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.0.0",
    "typescript": "^5.5.4",
    "vitest": "^4.1.0"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
