{
  "name": "temps-sdk",
  "type": "module",
  "version": "0.0.1-alpha.1",
  "workspaces": [
    "packages/*",
    "examples/**/*"
  ],
  "scripts": {
    "build": "bun run --filter @temps-sdk/* build",
    "test": "bun run --filter @temps-sdk/* test:run",
    "test:coverage": "bun run --filter @temps-sdk/* test:coverage",
    "clean": "bun run --filter @temps-sdk/* clean"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.5.4"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "nanoid": "3.3.18",
    "picomatch": "4.0.7",
    "postcss": "8.5.26",
    "rollup": "4.63.1",
    "vite": "6.4.3"
  }
}
