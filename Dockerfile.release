FROM debian:bookworm-slim@sha256:3783cc01769c7b2b1b83a5c5ad96c815348e28ed7da68e2e3687004faa906251

# Install runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    tzdata \
    wget \
    zlib1g \
    libgcc-s1 && \
    rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN groupadd --gid 1000 temps && \
    useradd --uid 1000 --gid temps --create-home --shell /usr/sbin/nologin temps

# Copy pre-built binary
COPY artifacts/temps /usr/local/bin/temps

# Fail the image build if the injected release artifact cannot execute in the
# selected libc/runtime environment.
RUN chmod +x /usr/local/bin/temps && /usr/local/bin/temps --version

# The city database is tracked in the repository and required by the proxy.
# Keep it outside /app/data so a persistent data volume cannot mask it.
COPY crates/temps-cli/GeoLite2-City.mmdb /usr/share/temps/GeoLite2-City.mmdb

# Create data directory
RUN mkdir -p /app/data && \
    chown -R temps:temps /app && \
    chmod 644 /usr/share/temps/GeoLite2-City.mmdb && \
    ln -s /usr/share/temps/GeoLite2-City.mmdb /app/GeoLite2-City.mmdb

# Switch to non-root user
USER temps
WORKDIR /app

# Expose port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3000/health || exit 1

# Run the binary
ENTRYPOINT ["/usr/local/bin/temps"]
CMD ["serve"]
