FROM debian:bookworm-slim@sha256:3783cc01769c7b2b1b83a5c5ad96c815348e28ed7da68e2e3687004faa906251

# Install runtime dependencies. `apt-get install` only touches the packages
# listed below, so upgrade first: otherwise packages baked into the base image
# (libpcre2, libc, ...) stay at whatever patch level the pinned digest shipped
# with, and Debian security fixes never reach the published image.
# Debian backports CVE-2026-111497 without changing the upstream version.
# Fail closed if a mirror cannot supply the fixed Brotli decoder.
RUN apt-get update && apt-get upgrade -y --no-install-recommends && \
    apt-get install -y --no-install-recommends \
    ca-certificates \
    git \
    libbrotli1 \
    tzdata \
    wget \
    zlib1g \
    libgcc-s1 && \
    dpkg --compare-versions "$(dpkg-query -W -f='${Version}' libbrotli1)" ge '1.0.9-2+deb12u1' && \
    rm -rf /var/lib/apt/lists/*

# PostgreSQL client tools for the control-plane backup. Without a local Docker
# daemon (the hosted control plane) it runs this image's own pg_dump and
# pg_dumpall, and refuses when they are older than the database's major
# version (ADR-100); Debian bookworm only carries PostgreSQL 15. Install the
# PostgreSQL 18 client from the PostgreSQL apt repository, trusting the
# repository key that Debian's own signed postgresql-common package ships
# (copied out so the helper package can be purged again). Fail the build if
# the installed tools do not report that major version.
ARG PG_CLIENT_MAJOR=18
RUN apt-get update && \
    apt-get install -y --no-install-recommends postgresql-common && \
    install -d -m 0755 /etc/apt/keyrings && \
    cp /usr/share/postgresql-common/pgdg/apt.postgresql.org.gpg /etc/apt/keyrings/pgdg.gpg && \
    . /etc/os-release && \
    echo "deb [signed-by=/etc/apt/keyrings/pgdg.gpg] https://apt.postgresql.org/pub/repos/apt ${VERSION_CODENAME}-pgdg main" \
        > /etc/apt/sources.list.d/pgdg.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends "postgresql-client-${PG_CLIENT_MAJOR}" && \
    apt-get purge -y postgresql-common && \
    apt-get autoremove -y && \
    pg_dump --version | grep -Eq "^pg_dump \(PostgreSQL\) ${PG_CLIENT_MAJOR}\." && \
    pg_dumpall --version | grep -Eq "^pg_dumpall \(PostgreSQL\) ${PG_CLIENT_MAJOR}\." && \
    rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN groupadd --gid 1000 temps && \
    useradd --uid 1000 --gid temps --create-home --shell /usr/sbin/nologin temps

# Copy pre-built binary
COPY artifacts/temps /usr/local/bin/temps

# Fail the image build if the injected release artifact cannot execute in the
# selected libc/runtime environment.
RUN chmod +x /usr/local/bin/temps && /usr/local/bin/temps --version

# The city database is tracked in the repository and required by the proxy.
# The ASN database is tracked alongside it and powers hosting/datacenter
# detection. Keep both outside /app/data so a persistent data volume cannot
# mask them.
COPY crates/temps-cli/GeoLite2-City.mmdb /usr/share/temps/GeoLite2-City.mmdb
COPY crates/temps-cli/GeoLite2-ASN.mmdb /usr/share/temps/GeoLite2-ASN.mmdb

# Create data directory
RUN mkdir -p /app/data && \
    chown -R temps:temps /app && \
    chmod 644 /usr/share/temps/GeoLite2-City.mmdb /usr/share/temps/GeoLite2-ASN.mmdb && \
    ln -s /usr/share/temps/GeoLite2-City.mmdb /app/GeoLite2-City.mmdb && \
    ln -s /usr/share/temps/GeoLite2-ASN.mmdb /app/GeoLite2-ASN.mmdb

# Switch to non-root user
USER temps
WORKDIR /app

# Expose port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3000/health || exit 1

# Run the binary
ENTRYPOINT ["/usr/local/bin/temps"]
CMD ["serve"]
