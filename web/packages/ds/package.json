{
  "name": "@temps-sdk/ds",
  "version": "0.1.0",
  "type": "module",
  "description": "Temps console design system — page, record, list and settings templates, the status vocabulary, and tokens, built on @temps-sdk/ui.",
  "license": "MIT OR Apache-2.0",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/tokens.css",
    "./tokens.json": "./tokens.json",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "tokens:check": "node scripts/tokens.mjs check",
    "tokens:build": "node scripts/tokens.mjs build",
    "audit:records": "node scripts/audit-records.mjs --dir src",
    "lint": "bun run typecheck && bun run tokens:check && bun run audit:records"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^8.0.0"
  },
  "dependencies": {
    "@temps-sdk/ui": "workspace:*",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "lucide-react": "^1.45.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.3.1",
    "recharts": "3.10.1",
    "typescript": "^7.0.2"
  }
}
