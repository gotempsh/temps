{
  "name": "@temps-sdk/op",
  "version": "0.1.2",
  "type": "module",
  "description": "The Temps operator design system — the op primitives (records, ledgers, status, viz, page templates) plus the skin they render in, as one self-contained package.",
  "license": "MIT OR Apache-2.0",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./op.css": "./src/op.css",
    "./tokens.json": "./tokens.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/op.css",
    "tokens.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "bun run build",
    "tokens:check": "node scripts/tokens.mjs check",
    "tokens:build": "node scripts/tokens.mjs build"
  },
  "peerDependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.30.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^8.0.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0"
  },
  "dependencies": {
    "cmdk": "^1.1.1",
    "react-simple-maps": "^3.0.0",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.2.4",
    "@types/react-simple-maps": "^3.0.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "typescript": "^5.9.2"
  }
}
