{
  "name": "@temps-sdk/console",
  "private": true,
  "version": "1.0.0",
  "description": "The Temps console — the full OSS web app, also exported as <TempsConsole> for downstream editions to consume whole.",
  "engines": {
    "node": ">=22.0.0"
  },
  "exports": {
    ".": "./src/App.tsx",
    "./app.css": "./src/globals.css",
    "./package.json": "./package.json",
    "./components/auth/login-form": "./src/components/auth/login-form.tsx",
    "./contexts/AuthContext": "./src/contexts/AuthContext.tsx",
    "./lib/return-to": "./src/lib/return-to.ts",
    "./api/react-query": "./src/api/client/@tanstack/react-query.gen.ts"
  },
  "scripts": {
    "openapi-ts": "openapi-ts",
    "dev": "rsbuild dev",
    "build": "rsbuild build",
    "start": "rsbuild preview",
    "preview": "rsbuild preview",
    "_comment:test": "Scoped to src/ so bun's runner does not pick up the Playwright specs under e2e/ -- it matches *.spec.ts too, and those only run under `bun run e2e`.",
    "test": "bun test src",
    "check:react-versions": "node scripts/check-react-versions.mjs",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "lint": "eslint . && tsc --noEmit",
    "lint:fix": "eslint . --fix",
    "lint:unused": "eslint . --rule 'unused-imports/no-unused-imports: error'",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\""
  },
