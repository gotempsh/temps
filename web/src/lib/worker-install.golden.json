      "mac": "(set -o pipefail; curl -fsSL https://temps.sh/install.sh | bash -s -- v0.1.0-nightly.20261104.0123abcde)"
    },
    {
      "install": {
        "kind": "nightly",
        "after": "v0.1.0-beta.60"
      },
      "linux": "(set -o pipefail; curl -fsSL https://temps.sh/install.sh | sudo -H bash -s -- --channel nightly)",
      "mac": "(set -o pipefail; curl -fsSL https://temps.sh/install.sh | bash -s -- --channel nightly)"
    },
    {
      "install": {
        "kind": "latest"
