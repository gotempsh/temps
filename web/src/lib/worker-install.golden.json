  ],
  "as_root_temps": [
    {
      "args": "agent service install",
      "command": "sudo -H /root/.temps/bin/temps agent service install"
    },
    {
      "args": "join --pair -",
      "command": "sudo -H /root/.temps/bin/temps join --pair -"
    }
  ],
