{
  "_comment": "The commands a new worker runs to install Temps. Both renderers are tested against this file: web/src/lib/worker-join-script.ts (the console's Add worker panel) and crates/temps-core/src/worker_install.rs (the server's pairing command). Change it together with both.",
  "installer_url": "https://temps.sh/install.sh",
