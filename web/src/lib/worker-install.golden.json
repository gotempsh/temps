      "linux": "(set -o pipefail; curl -fsSL https://temps.sh/install.sh | sudo -H bash -s -- v0.1.0-beta.60)",
      "mac": "(set -o pipefail; curl -fsSL https://temps.sh/install.sh | bash -s -- v0.1.0-beta.60)"
    },
